# Copy this file to .env and fill in real values. .env is gitignored.

# Server
PORT=4000

# MySQL — point at local MySQL (Workbench) or a Railway MySQL instance
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=express_mysql
# Set to true when connecting to Railway / any hosted MySQL that requires SSL
DB_SSL=false

# Secret used to sign the admin session cookie. REQUIRED in production
# (Vercel / Railway) — set it to a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Google Places API — used by GET /api/testimoni/google (optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACE_ID=your_google_place_id_here
